#!/usr/bin/env bash
set -euo pipefail

if (($# > 0)); then
	exec vllm serve "$@"
fi
model=${KUVRYN_MODEL:-}
if [[ -z "$model" ]]; then
	echo "KUVRYN_MODEL must be a Hugging Face model id or local model path for vLLM" >&2
	exit 2
fi
host=${KUVRYN_HOST:-0.0.0.0}
port=${KUVRYN_PORT:-8000}
# shellcheck disable=SC2206 # KUVRYN_VLLM_ARGS intentionally allows vLLM serve flags.
extra=(${KUVRYN_VLLM_ARGS:-})
exec vllm serve "$model" --host "$host" --port "$port" "${extra[@]}"
